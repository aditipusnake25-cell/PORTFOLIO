# Use a locally running MongoDB or your own MongoDB connection string.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=portfolio

# These are required when the API starts. Keep the email key blank if you do not
# configure OWNER_EMAIL; set a real key before enabling owner notifications.
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=Portfolio

# Set a long random value before using admin sessions.
SESSION_SECRET=replace-with-a-long-random-secret

# Leave empty to keep admin login unavailable until a passcode hash is configured.
ADMIN_PASSCODE_HASH=

# Optional: enable owner notification emails and set a reply-to address.
OWNER_EMAIL=
EMAIL_REPLY_TO=
